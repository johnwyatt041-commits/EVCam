<?xml version='1.0' encoding='utf-8'?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ui_page_padding"
            android:paddingBottom="16dp"
            android:background="@color/page_background">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/ui_card">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/ui_recording_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="待机"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="预览与录像独立控制"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_recording_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="00:00 / 1"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="monospace"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/btn_take_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:text="拍照"
                    android:layout_marginEnd="10dp" />
                <Button
                    android:id="@+id/btn_start_record"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:minWidth="128dp"
                    android:text="开始录制"
                    android:backgroundTint="@color/ui_danger"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="10dp" />
                <Button
                    android:id="@+id/btn_exit"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:text="退出" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/ui_preview_editor_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
            <com.kooo.evcam.ui.EditablePreviewLayout
                android:id="@+id/ui_preview_layout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ui_card"
                    android:id="@+id/ui_preview_frame_left"
                    android:tag="left">
                    <com.kooo.evcam.AutoFitTextureView
                        android:id="@+id/texture_left"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />
                    <TextView
                        android:id="@+id/label_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/camera_label_background"
                        android:text="左侧"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ui_card"
                    android:id="@+id/ui_preview_frame_front"
                    android:tag="front">
                    <com.kooo.evcam.AutoFitTextureView
                        android:id="@+id/texture_front"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />
                    <TextView
                        android:id="@+id/label_front"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/camera_label_background"
                        android:text="前方"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ui_card"
                    android:id="@+id/ui_preview_frame_back"
                    android:tag="back">
                    <com.kooo.evcam.AutoFitTextureView
                        android:id="@+id/texture_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />
                    <TextView
                        android:id="@+id/label_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/camera_label_background"
                        android:text="后方"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ui_card"
                    android:id="@+id/ui_preview_frame_right"
                    android:tag="right">
                    <com.kooo.evcam.AutoFitTextureView
                        android:id="@+id/texture_right"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />
                    <TextView
                        android:id="@+id/label_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/camera_label_background"
                        android:text="右侧"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </FrameLayout>
            </com.kooo.evcam.ui.EditablePreviewLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_debug_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/nav_background"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/navigation_menu"
        app:itemTextAppearance="@style/NavigationMenuTextAppearance" />
</androidx.drawerlayout.widget.DrawerLayout>