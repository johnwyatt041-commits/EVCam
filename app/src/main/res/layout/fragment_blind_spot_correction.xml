<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="15dp"
        android:paddingBottom="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:background="@color/menu_background">
        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="16sp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text"
            android:elevation="0dp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="补盲画面矫正"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />
        <Button
            android:id="@+id/btn_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌂"
            android:textSize="16sp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text"
            android:elevation="0dp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/ui_card"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择摄像头"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btn_camera_front"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="前"
                        android:textSize="16sp"
                        android:backgroundTint="@color/button_accent"
                        android:textColor="@color/white"
                        android:minHeight="48dp"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />
                    <Button
                        android:id="@+id/btn_camera_back"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="后"
                        android:textSize="16sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:minHeight="48dp"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />
                    <Button
                        android:id="@+id/btn_camera_left"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="左"
                        android:textSize="16sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:minHeight="48dp"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />
                    <Button
                        android:id="@+id/btn_camera_right"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="右"
                        android:textSize="16sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:minHeight="48dp"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_preview_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="进入本页后会自动弹出补盲悬浮窗实时预览"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/ui_card"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="缩放 (Scale)"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="sans-serif-medium" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:text="ScaleX"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <SeekBar
                        android:id="@+id/seek_scale_x"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/tv_scale_x"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="1.00"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:text="ScaleY"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <SeekBar
                        android:id="@+id/seek_scale_y"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/tv_scale_y"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="1.00"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/ui_card"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="平移 (Translate)"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="sans-serif-medium" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:text="TransX"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <SeekBar
                        android:id="@+id/seek_translate_x"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/tv_translate_x"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0.00"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:text="TransY"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <SeekBar
                        android:id="@+id/seek_translate_y"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                    <TextView
                        android:id="@+id/tv_translate_y"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0.00"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/ui_card"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="旋转 (Rotation)"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="sans-serif-medium" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:text="角度"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <SeekBar
                        android:id="@+id/seek_rotation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="360" />
                    <TextView
                        android:id="@+id/tv_rotation"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0°"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/ui_card"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="双镜像配置 (物理镜像 + 分端输出镜像)"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. 传感器物理镜像（同摄像头所有输出端共用）"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">
                    <Button
                        android:id="@+id/btn_physical_mirror_h"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="物理水平"
                        android:textSize="15sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:minHeight="44dp"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />
                    <Button
                        android:id="@+id/btn_physical_mirror_v"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="物理垂直"
                        android:textSize="15sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:minHeight="44dp"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. 输出端独立镜像（互不影响，默认主预览后摄水平镜像）"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <Button
                        android:id="@+id/btn_mirror_target_blind_spot"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="主屏补盲"
                        android:textSize="12sp"
                        android:paddingHorizontal="4dp"
                        android:backgroundTint="@color/button_accent"
                        android:textColor="@color/white"
                        android:elevation="0dp"
                        android:textAllCaps="false" />
                    <Button
                        android:id="@+id/btn_mirror_target_main"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="主预览"
                        android:textSize="12sp"
                        android:paddingHorizontal="4dp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:textAllCaps="false" />
                    <Button
                        android:id="@+id/btn_mirror_target_secondary"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="副屏 HUD"
                        android:textSize="12sp"
                        android:paddingHorizontal="4dp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:textAllCaps="false" />
                    <Button
                        android:id="@+id/btn_mirror_target_stream"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="ESP32 流"
                        android:textSize="12sp"
                        android:paddingHorizontal="4dp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:textAllCaps="false" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Button
                        android:id="@+id/btn_mirror_h"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="输出水平镜像"
                        android:textSize="15sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:minHeight="48dp"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />
                    <Button
                        android:id="@+id/btn_mirror_v"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="输出垂直镜像"
                        android:textSize="15sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:minHeight="48dp"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <Button
                    android:id="@+id/btn_reset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="恢复默认"
                    android:backgroundTint="@color/button_background"
                    android:textColor="@color/button_text"
                    android:textSize="16sp"
                    android:minHeight="48dp"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false" />
                <Button
                    android:id="@+id/btn_save_apply"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="保存并应用"
                    android:backgroundTint="@color/button_accent"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:minHeight="48dp"
                    android:elevation="0dp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>