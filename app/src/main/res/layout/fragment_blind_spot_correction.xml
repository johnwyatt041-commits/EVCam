<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_background">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="@color/page_background">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← 返回"
            android:textSize="15sp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text"
            android:elevation="0dp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="分方向旋转与四边裁切"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btn_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="菜单"
            android:textSize="14sp"
            android:minHeight="48dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text"
            android:elevation="0dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="主页"
            android:textSize="14sp"
            android:minHeight="48dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text"
            android:elevation="0dp"
            android:textAllCaps="false" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <!-- 通道选择与范围说明卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/ui_card"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="选择补盲摄像头方向"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_toggle_floating_preview"
                        style="@style/Widget.EVCam.OptionPill"
                        android:text="开启浮窗实景预览" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <Button
                        android:id="@+id/btn_cam_front"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="前路" />

                    <Button
                        android:id="@+id/btn_cam_back"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="后路" />

                    <Button
                        android:id="@+id/btn_cam_left"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="左路" />

                    <Button
                        android:id="@+id/btn_cam_right"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="右路" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="各方向的旋转与四边裁切仅用于补盲画面（主屏补盲弹窗 / 副屏 HUD），不影响记录仪主预览和录像，保持原始画面比例。"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 旋转角度 + 四边裁切预览与滑块卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/ui_card"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <com.kooo.evcam.blindspot.BlindSpotCropPreviewView
                    android:id="@+id/blind_spot_crop_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="14dp" />

                <!-- 独立旋转角度 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="旋转角度"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_rotation_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0°"
                        android:textColor="@color/button_accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btn_rot_0"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="0°" />

                    <Button
                        android:id="@+id/btn_rot_90"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="90°" />

                    <Button
                        android:id="@+id/btn_rot_180"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="180°" />

                    <Button
                        android:id="@+id/btn_rot_270"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="270°" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekbar_rotation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="359"
                    android:layout_marginBottom="14dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ui_border"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="四边裁切（按可视化百分比裁去冗余边角）"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_crop_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="保留 100% × 100%"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 上边缘裁切 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="上边缘"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/seekbar_crop_top"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="45" />

                    <TextView
                        android:id="@+id/tv_crop_top_value"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:gravity="end"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 下边缘裁切 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="下边缘"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/seekbar_crop_bottom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="45" />

                    <TextView
                        android:id="@+id/tv_crop_bottom_value"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:gravity="end"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 左边缘裁切 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="左边缘"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/seekbar_crop_left"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="45" />

                    <TextView
                        android:id="@+id/tv_crop_left_value"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:gravity="end"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 右边缘裁切 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:text="右边缘"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/seekbar_crop_right"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="45" />

                    <TextView
                        android:id="@+id/tv_crop_right_value"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:gravity="end"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 物理镜像与输出镜像解耦配置卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/ui_card"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="物理镜像与补盲输出镜像"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <Button
                        android:id="@+id/btn_physical_mirror_h"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="物理水平镜像" />

                    <Button
                        android:id="@+id/btn_physical_mirror_v"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="物理垂直翻转" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="输出端独立镜像"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btn_target_blind_spot"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="主屏补盲窗" />

                    <Button
                        android:id="@+id/btn_target_secondary_hud"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="副屏 HUD" />

                    <Button
                        android:id="@+id/btn_target_network_stream"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="ESP32 投屏" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btn_output_mirror_h"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="输出水平镜像" />

                    <Button
                        android:id="@+id/btn_output_mirror_v"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="输出垂直翻转" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_mirror_effective_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="物理H:关 / 输出H:关 → 实际生效H:关"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 底部操作 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_reset_current"
                    style="@style/Widget.EVCam.OptionPill"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ui_button_height"
                    android:minHeight="@dimen/ui_button_height"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:textSize="@dimen/ui_button_text_size"
                    android:text="恢复当前方向默认" />

                <Button
                    android:id="@+id/btn_save_correction"
                    style="@style/Widget.EVCam.OptionPill"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ui_button_height"
                    android:minHeight="@dimen/ui_button_height"
                    android:layout_weight="1"
                    android:textSize="@dimen/ui_button_text_size"
                    android:text="保存并应用" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
