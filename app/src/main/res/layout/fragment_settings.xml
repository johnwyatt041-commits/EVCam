<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_master_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/page_background">

    <LinearLayout
        android:id="@+id/settings_sidebar"
        android:layout_width="@dimen/ui_settings_sidebar_width"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/nav_background">

        <TextView
            android:id="@+id/tv_settings_sidebar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp"
            android:text="设置"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_settings_catalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="16dp" />
        </ScrollView>
    </LinearLayout>

    <View
        android:id="@+id/settings_pane_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/ui_border" />

    <FrameLayout
        android:id="@+id/settings_detail_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/page_background" />
</LinearLayout>
