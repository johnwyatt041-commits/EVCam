<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/ui_card">
    <TextView
        android:id="@+id/ui_layout_editor_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="拖动画面移动位置，拖动右下角调整大小；点击下方路数可按路显隐（隐藏路释放预览并停用未使用相机）。"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="8dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="预览路数："
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="8dp" />
        <Button
            android:id="@+id/ui_vis_front"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:text="前 · 开"
            android:layout_marginEnd="6dp" />
        <Button
            android:id="@+id/ui_vis_back"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:text="后 · 开"
            android:layout_marginEnd="6dp" />
        <Button
            android:id="@+id/ui_vis_left"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:text="左 · 开"
            android:layout_marginEnd="6dp" />
        <Button
            android:id="@+id/ui_vis_right"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:text="右 · 开" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">
        <Button
            android:id="@+id/ui_layout_presets"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="选择排版"
            android:layout_marginEnd="8dp" />
        <Button
            android:id="@+id/ui_layout_reset"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="恢复默认"
            android:layout_marginEnd="8dp" />
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <Button
            android:id="@+id/ui_layout_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="取消"
            android:layout_marginEnd="8dp" />
        <Button
            android:id="@+id/ui_layout_save"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="保存布局"
            android:backgroundTint="@color/button_accent"
            android:textColor="@color/ui_on_accent" />
    </LinearLayout>
</LinearLayout>
