<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_background">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="18dp"
        android:paddingBottom="10dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="@color/page_background">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="←"
            android:textSize="16sp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text"
            android:elevation="0dp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:text="360 画面"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- 左列：4.1 预览与分视角 + 4.2 R 档与自动返桌 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="14dp"
                android:orientation="vertical">

                <!-- 4.1 预览模式与分视角布局 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.1 预览模式与分视角布局"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_surround_mode_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:text="当前主预览模式：分栏 B"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_surround_mode_a"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="360 全景 (模式 A)" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_surround_mode_b"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="原始分栏 (模式 B)" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_surround_mode_c"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="三路大屏 (模式 C)" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_surround_mode_d"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="双视转向 (模式 D)" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_surround_mode_e"
                                style="@style/Widget.EVCam.OptionPill"
                                android:text="左右双摄 (模式 E)" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="仅在模式 A 前台激活时按需创建 360 GL 上下文，切回 B/C/D/E 或退后台即销毁。"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/ui_border" />

                    <!-- 右上视角 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="右侧上方视角"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_top_view_drive"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="6dp"
                                android:text="随档位" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_top_view_front"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="6dp"
                                android:text="前视" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_top_view_rear"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="6dp"
                                android:text="后视" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_top_view_front_wheels"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="6dp"
                                android:text="前轮" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_top_view_rear_wheels"
                                style="@style/Widget.EVCam.OptionPill"
                                android:text="后轮" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- 右下视角 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="右侧下方视角"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_bottom_view_front_wheels"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="前轮" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_bottom_view_rear_wheels"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="后轮" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_bottom_view_sides"
                                style="@style/Widget.EVCam.OptionPill"
                                android:text="左右侧视" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/ui_border" />

                    <!-- 模式 D 右侧视角联动 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="模式 D 右侧视角联动"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_mode_d_linkage_turn_signal"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="随转向灯" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_mode_d_linkage_steering"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="随方向盘" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_mode_d_linkage_manual"
                                style="@style/Widget.EVCam.OptionPill"
                                android:text="手动切换" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="控制双视转向（模式 D）右侧左/右视角自动联动方式；画面内也支持一键手动左/右切换。"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/ui_border" />

                    <!-- 开关项：暂停补盲 / 拉伸铺满 / 视图内按键显隐 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="显示 360 时暂停主屏补盲"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="保留 EVCC 副屏与 ESP32 HUD，仅抑制主屏补盲浮窗"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_surround_suppress_blindspot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="前后视拉伸铺满"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="开启后将右上前/后道路画面铺满当前分屏视口"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_surround_stretch_road"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="显示画内视角/手动切换按键"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="与外观设置同步，控制 360 A 视角/轮位按钮及模式 C/D 画内视角切换按钮"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_surround_overlay_buttons"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 4.2 R 档自动预览与返桌策略 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.2 R 档自动预览与返桌策略"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="10dp" />

                    <!-- R 档自动打开 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="R 档自动打开预览"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_reverse_preview_enabled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:id="@+id/tv_reverse_delay_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="触发延迟：200 ms（范围 0–5000 ms）"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_reverse_delay_minus"
                            style="@style/Widget.EVCam.OptionPill"
                            android:layout_marginEnd="6dp"
                            android:text="-50ms" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_reverse_delay_plus"
                            style="@style/Widget.EVCam.OptionPill"
                            android:text="+50ms" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/ui_border" />

                    <!-- 车速自动返桌 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="车速自动返回桌面"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="仅对 R 档自动拉起的预览生效，不影响手动打开"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_speed_close_enabled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:id="@+id/tv_speed_threshold_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="返桌速度阈值：20 km/h（范围 15–50）"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_speed_threshold_minus"
                            style="@style/Widget.EVCam.OptionPill"
                            android:layout_marginEnd="6dp"
                            android:text="-1 km/h" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_speed_threshold_plus"
                            style="@style/Widget.EVCam.OptionPill"
                            android:text="+1 km/h" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/ui_border" />

                    <!-- P 档延时返桌 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="P 档延时返回桌面"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="仅对 R 档自动拉起的预览生效，后台录像保持运行"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_park_close_enabled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tv_park_close_delay_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="等待时长：3 秒（范围 1–60 秒）"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_park_delay_minus"
                            style="@style/Widget.EVCam.OptionPill"
                            android:layout_marginEnd="6dp"
                            android:text="-1秒" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_park_delay_plus"
                            style="@style/Widget.EVCam.OptionPill"
                            android:text="+1秒" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 右列：4.3 银河 E5 校准、动态引导线与离线车模 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 4.3 E5 校准与地面视野 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="4.3 银河 E5 校准与地面视野"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_calibration_live_preview"
                            style="@style/Widget.EVCam.OptionPill"
                            android:text="实时预览调校" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_surround_calibration_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:text="当前方案：银河 E5 内置校准"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_calibration_e5_builtin"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="银河 E5 内置校准" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_calibration_import_local"
                                style="@style/Widget.EVCam.OptionPill"
                                android:text="导入本地/原厂校准" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- 地面宽度 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:id="@+id/tv_ground_width_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="地面宽度：206 cm（160–260）"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_ground_width_minus"
                            style="@style/Widget.EVCam.OptionPill"
                            android:layout_marginEnd="6dp"
                            android:text="-5" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_ground_width_plus"
                            style="@style/Widget.EVCam.OptionPill"
                            android:text="+5" />
                    </LinearLayout>

                    <!-- 地面长度 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:id="@+id/tv_ground_length_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="地面长度：530 cm（420–600）"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_ground_length_minus"
                            style="@style/Widget.EVCam.OptionPill"
                            android:layout_marginEnd="6dp"
                            android:text="-10" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_ground_length_plus"
                            style="@style/Widget.EVCam.OptionPill"
                            android:text="+10" />
                    </LinearLayout>

                    <!-- 车头前方延伸 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:id="@+id/tv_ground_front_ext_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="车头视野延伸：0 cm（0–100）"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_ground_ext_minus"
                            style="@style/Widget.EVCam.OptionPill"
                            android:layout_marginEnd="6dp"
                            android:text="-10" />
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_ground_ext_plus"
                            style="@style/Widget.EVCam.OptionPill"
                            android:text="+10" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_ground_reset_default"
                        style="@style/Widget.EVCam.OptionPill"
                        android:text="恢复 E5 默认拼接视野" />
                </LinearLayout>

                <!-- 泊车辅助与离线 E5 车模 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="泊车引导线与离线 E5 车模"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="动态转向与倒车辅助引导线"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="已在模式 A 移除环境提醒及前雷达冗余提示字"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_surround_guidance_enabled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_guidance_auto_rules"
                        style="@style/Widget.EVCam.OptionPill"
                        android:layout_marginBottom="12dp"
                        android:text="按车速/档位自动开关引导线 →" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/ui_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_car_model_preview"
                            android:layout_width="76dp"
                            android:layout_height="156dp"
                            android:layout_marginEnd="14dp"
                            android:padding="6dp"
                            android:background="@color/input_background"
                            android:scaleType="fitCenter"
                            android:contentDescription="银河 E5 俯视车模预览" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_car_model_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="当前车模：银河 E5 内置车模"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="纯离线车模管理（已彻底移除云端车模库请求），支持本地透明 PNG 车模（≤ 4 MB）。"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginBottom="10dp" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_car_model_builtin"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginBottom="8dp"
                                android:text="使用银河 E5 内置车模" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_car_model_import_png"
                                style="@style/Widget.EVCam.OptionPill"
                                android:text="从 Download 导入本地 PNG 车模" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
