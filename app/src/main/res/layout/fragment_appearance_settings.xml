<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_background">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="18dp"
        android:paddingBottom="10dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="@color/page_background">
        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="←"
            android:textSize="16sp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text"
            android:elevation="0dp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:text="外观与交互"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- 左列 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="14dp"
                android:orientation="vertical">

                <!-- 1. 外观（浅色 / 深色 / 跟随系统） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="外观"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_theme_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="当前：跟随系统"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_theme_light"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="浅色" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_theme_dark"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="深色" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_theme_follow_system"
                                style="@style/Widget.EVCam.OptionPill"
                                android:text="跟随系统" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- 2. 默认页面 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="默认页面"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_start_page_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="打开应用时自动进入所选页面"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_start_recording"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="记录仪" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_start_playback"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="回看" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_start_settings"
                                style="@style/Widget.EVCam.OptionPill"
                                android:text="设置" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- 3. 主预览模式与布局形态 (T03 + T04) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="主预览模式与布局形态"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_preview_mode_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:text="当前默认模式：分栏 B（三列分屏）"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_default_mode_a"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:layout_marginEnd="8dp"
                                android:ellipsize="end"
                                android:text="全景 A · 360" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_default_mode_b"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:ellipsize="end"
                                android:text="分栏 B · 三列" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_default_mode_c"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:layout_marginEnd="8dp"
                                android:ellipsize="end"
                                android:text="三路 C · 双侧" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_default_mode_d"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:ellipsize="end"
                                android:text="模式 D · 转向" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/ui_border" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="默认预览布局形态"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_preview_presentation_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:text="当前形态：保留侧边栏（默认）"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_presentation_sidebar"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="侧边栏" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_presentation_fullscreen"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="全屏" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_presentation_window"
                                style="@style/Widget.EVCam.OptionPill"
                                android:text="独立小窗" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>

            <!-- 右列 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 菜单与按钮尺寸（标准自适应 / 车机大号） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="菜单与按钮缩放"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_ui_scale_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="当前：标准（已按大屏自动适配）"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_ui_scale_standard"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="标准（自适应）" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_ui_scale_large"
                                style="@style/Widget.EVCam.OptionPill"
                                android:text="车机大号" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- 4. 开门退出（退出前确认 + 秒数胶囊） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开门退出"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="退出前确认"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_confirm_door_exit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fillViewport="true"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_door_exit_3s"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:layout_marginEnd="4dp"
                                android:text="3秒" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_door_exit_5s"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:layout_marginEnd="4dp"
                                android:text="5秒" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_door_exit_10s"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:layout_marginEnd="4dp"
                                android:text="10秒" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_door_exit_15s"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:layout_marginEnd="4dp"
                                android:text="15秒" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_door_exit_30s"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:text="30秒" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="开启后，车门开启触发退出流程前按所选时长倒计时确认（将在 T06 接入信号）。"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 5. 快捷键与悬浮层 (T03 + T04) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/ui_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快捷键与悬浮层"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="画内视角切换按钮"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="统一控制 360 模式 A 视角/轮位按钮及模式 C/D 画内手动「前/后」按钮"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_view_shortcuts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/ui_border" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="左上角「返回 / 设置」快捷键"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_corner_nav_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:text="当前策略：仅沉浸全屏显示"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_corner_nav_auto"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="仅全屏" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_corner_nav_always"
                                style="@style/Widget.EVCam.OptionPill"
                                android:layout_marginEnd="8dp"
                                android:text="始终显示" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_corner_nav_hidden"
                                style="@style/Widget.EVCam.OptionPill"
                                android:text="关闭" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/ui_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="无障碍高层级悬浮窗 (2032)"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="优先使用 TYPE_ACCESSIBILITY_OVERLAY，解绑自动降级 2038"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_accessibility_overlay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
