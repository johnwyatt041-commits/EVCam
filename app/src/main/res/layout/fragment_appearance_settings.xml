<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_background">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="15dp"
        android:paddingBottom="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:background="@color/menu_background">
        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="←"
            android:textSize="16sp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text"
            android:elevation="0dp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:text="1. 外观与交互"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. 三态主题（跟随系统 / 深色 / 浅色） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/ui_card"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="主题外观"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_theme_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="当前：跟随系统"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:text="原地零重建切换深浅色，录制与预览期间不中断。"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_theme_follow_system"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="跟随系统"
                        android:textSize="14sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btn_theme_dark"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="深色"
                        android:textSize="14sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btn_theme_light"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="浅色"
                        android:textSize="14sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. 默认启动页 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/ui_card"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="默认启动页"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_start_page_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="当前默认页面：记录仪"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:text="冷启动进入主界面时的默认页面；若开启「启动自动录制」，启动后将优先显示记录仪。"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_start_recording"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="记录仪"
                        android:textSize="14sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btn_start_playback"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="回看"
                        android:textSize="14sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btn_start_settings"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="设置"
                        android:textSize="14sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. T03 主预览模式与画面快捷键 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/ui_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="主预览模式与快捷键"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_preview_mode_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="当前默认模式：分栏 B（三列分屏）"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_default_mode_b"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="分栏 B · 三列分屏"
                        android:textSize="14sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btn_default_mode_c"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="三路 C · 档位大屏"
                        android:textSize="14sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/ui_border" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="左上角「返回 / 设置」快捷键"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_corner_nav_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="当前策略：仅沉浸全屏显示"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_corner_nav_auto"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="仅全屏显示"
                        android:textSize="13sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btn_corner_nav_always"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="始终显示"
                        android:textSize="13sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btn_corner_nav_hidden"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="隐藏"
                        android:textSize="13sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/ui_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="显示「视图切换 (B/C)」快捷键"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="在主预览左上角悬浮条显示模式 B / C、主副屏切换与全屏按钮（默认开启）"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_view_shortcuts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/ui_border" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="默认预览布局形态 (4.2)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_preview_presentation_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="当前形态：保留侧边栏（默认）"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_presentation_sidebar"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="保留侧边栏"
                        android:textSize="13sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btn_presentation_fullscreen"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="全屏预览"
                        android:textSize="13sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btn_presentation_window"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="独立悬浮窗"
                        android:textSize="13sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text"
                        android:elevation="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:textAllCaps="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/ui_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="无障碍高层级悬浮窗 (2032)"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="已启用无障碍保活时优先以 TYPE_ACCESSIBILITY_OVERLAY 显示主屏悬浮窗（不抢焦点/不拦返回，解绑自动降级 2038）；EVCC 副屏固定保持 2038"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_accessibility_overlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. confirm_door_exit 开关持久化预留 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/ui_card">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开门退出二次确认"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="开启后，车门开启触发退出或退后台流程前弹出确认提示（配置项已持久保存，信号自动触发将在 T06 车机信号中枢接入）"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_confirm_door_exit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
