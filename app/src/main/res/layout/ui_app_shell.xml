<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ui_shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/page_background">

    <LinearLayout
        android:id="@+id/ui_rail"
        android:layout_width="@dimen/ui_rail_width"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/ui_rail_padding"
        android:background="@color/nav_background">

        <TextView
            android:id="@+id/ui_rail_brand"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_rail_brand_height"
            android:gravity="center"
            android:text="EV"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/ui_nav_text_size"
            android:fontFamily="sans-serif-medium" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ui_nav_recording"
                    style="@style/Widget.EVCam.Navigation"
                    android:text="记录仪"
                    android:drawableTop="@drawable/ic_nav_recording"
                    android:contentDescription="记录仪" />

                <TextView
                    android:id="@+id/ui_nav_playback"
                    style="@style/Widget.EVCam.Navigation"
                    android:text="回看"
                    android:drawableTop="@drawable/ic_nav_playback"
                    android:contentDescription="回看" />

                <TextView
                    android:id="@+id/ui_nav_blind_spot"
                    style="@style/Widget.EVCam.Navigation"
                    android:text="补盲"
                    android:drawableTop="@drawable/ic_nav_remote"
                    android:contentDescription="补盲" />

                <TextView
                    android:id="@+id/ui_nav_feishu"
                    style="@style/Widget.EVCam.Navigation"
                    android:layout_marginBottom="0dp"
                    android:text="飞书"
                    android:drawableTop="@drawable/ic_nav_feishu"
                    android:contentDescription="飞书" />
            </LinearLayout>
        </ScrollView>

        <View
            android:id="@+id/ui_rail_footer_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/ui_border" />

        <TextView
            android:id="@+id/ui_nav_settings"
            style="@style/Widget.EVCam.Navigation.Footer"
            android:text="设置"
            android:drawableTop="@drawable/ic_nav_settings"
            android:contentDescription="设置" />

        <TextView
            android:id="@+id/ui_nav_exit"
            style="@style/Widget.EVCam.Navigation.Footer"
            android:layout_marginBottom="0dp"
            android:text="退出"
            android:drawableTop="@drawable/ic_nav_exit"
            android:contentDescription="退出" />
    </LinearLayout>

    <View
        android:id="@+id/ui_rail_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/ui_border" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/page_background">

        <LinearLayout
            android:id="@+id/ui_top_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/ui_page_padding"
            android:paddingEnd="@dimen/ui_page_padding"
            android:background="@color/menu_background">

            <Button
                android:id="@+id/ui_back"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="← 返回"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ui_page_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="记录仪"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/ui_recording_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:text="待机"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/ui_edit_layout"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:text="编辑布局" />

            <Button
                android:id="@+id/ui_preview_toggle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="开启预览" />
        </LinearLayout>

        <View
            android:id="@+id/ui_topbar_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ui_border" />

        <FrameLayout
            android:id="@+id/ui_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/page_background" />
    </LinearLayout>
</LinearLayout>
