<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ui_shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/page_background">

    <LinearLayout
        android:id="@+id/ui_rail"
        android:layout_width="@dimen/ui_rail_width"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_rail_padding"
        android:paddingEnd="@dimen/ui_rail_padding"
        android:paddingTop="@dimen/ui_rail_padding"
        android:paddingBottom="@dimen/ui_rail_padding"
        android:background="@color/nav_background">

        <TextView
            android:id="@+id/ui_rail_brand"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_rail_brand_height"
            android:gravity="center"
            android:text="EV"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/ui_nav_text_size"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ui_nav_record_toggle"
            style="@style/Widget.EVCam.Navigation"
            android:layout_marginBottom="@dimen/ui_nav_gap"
            android:text="开始录制"
            android:drawableTop="@drawable/ic_nav_record_circle"
            android:contentDescription="开始或停止录制" />

        <View
            android:id="@+id/ui_rail_record_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:background="@color/ui_border" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ui_nav_recording"
                    style="@style/Widget.EVCam.Navigation"
                    android:text="记录仪"
                    android:drawableTop="@drawable/ic_nav_recording"
                    android:contentDescription="记录仪" />

                <TextView
                    android:id="@+id/ui_nav_playback"
                    style="@style/Widget.EVCam.Navigation"
                    android:text="回看"
                    android:drawableTop="@drawable/ic_nav_playback"
                    android:contentDescription="回看" />

                <TextView
                    android:id="@+id/ui_nav_blind_spot"
                    style="@style/Widget.EVCam.Navigation"
                    android:text="补盲"
                    android:drawableTop="@drawable/ic_nav_remote"
                    android:visibility="gone"
                    android:contentDescription="补盲" />

                <TextView
                    android:id="@+id/ui_nav_feishu"
                    style="@style/Widget.EVCam.Navigation"
                    android:layout_marginBottom="0dp"
                    android:text="飞书"
                    android:drawableTop="@drawable/ic_nav_feishu"
                    android:visibility="gone"
                    android:contentDescription="飞书" />
            </LinearLayout>
        </ScrollView>

        <View
            android:id="@+id/ui_rail_footer_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/ui_border"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ui_nav_settings"
            style="@style/Widget.EVCam.Navigation.Footer"
            android:text="设置"
            android:drawableTop="@drawable/ic_nav_settings"
            android:contentDescription="设置" />

        <TextView
            android:id="@+id/ui_nav_exit"
            style="@style/Widget.EVCam.Navigation.Footer"
            android:layout_marginBottom="4dp"
            android:text="退出"
            android:drawableTop="@drawable/ic_nav_exit"
            android:contentDescription="退出" />

        <TextView
            android:id="@+id/ui_rail_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="V1.6.6"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/ui_rail_version_text_size"
            android:maxLines="1" />
    </LinearLayout>

    <View
        android:id="@+id/ui_rail_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/ui_border" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/page_background">

        <LinearLayout
            android:id="@+id/ui_top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_top_bar_height"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/ui_page_padding"
            android:paddingEnd="@dimen/ui_page_padding"
            android:background="@color/menu_background">

            <Button
                android:id="@+id/ui_back"
                style="@style/Widget.EVCam.TopBarButton"
                android:layout_marginEnd="@dimen/ui_top_bar_group_gap"
                android:text="← 返回"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ui_page_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/ui_top_bar_group_gap"
                android:text="记录仪"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ui_top_bar_title_text_size"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/ui_recording_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ui_top_bar_group_gap"
                android:text="待机"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ui_top_bar_status_text_size"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/ui_edit_layout"
                style="@style/Widget.EVCam.TopBarButton"
                android:layout_marginEnd="@dimen/ui_top_bar_group_gap"
                android:text="编辑布局" />

            <LinearLayout
                android:id="@+id/ui_preview_mode_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/ui_mode_a"
                    style="@style/Widget.EVCam.TopBarButton"
                    android:layout_marginEnd="@dimen/ui_top_bar_button_gap"
                    android:text="360 A" />

                <Button
                    android:id="@+id/ui_mode_b"
                    style="@style/Widget.EVCam.TopBarButton"
                    android:layout_marginEnd="@dimen/ui_top_bar_button_gap"
                    android:text="分栏 B" />

                <Button
                    android:id="@+id/ui_mode_c"
                    style="@style/Widget.EVCam.TopBarButton"
                    android:layout_marginEnd="@dimen/ui_top_bar_button_gap"
                    android:text="三路 C" />

                <Button
                    android:id="@+id/ui_mode_d"
                    style="@style/Widget.EVCam.TopBarButton"
                    android:layout_marginEnd="@dimen/ui_top_bar_button_gap"
                    android:text="模式 D" />

                <Button
                    android:id="@+id/ui_mode_e"
                    style="@style/Widget.EVCam.TopBarButton"
                    android:layout_marginEnd="@dimen/ui_top_bar_button_gap"
                    android:text="左右 E" />

                <Button
                    android:id="@+id/ui_fullscreen_toggle"
                    style="@style/Widget.EVCam.TopBarButton"
                    android:layout_marginEnd="@dimen/ui_top_bar_button_gap"
                    android:text="全屏" />

                <Button
                    android:id="@+id/ui_floating_window_toggle"
                    style="@style/Widget.EVCam.TopBarButton"
                    android:layout_marginEnd="@dimen/ui_top_bar_group_gap"
                    android:text="小窗" />
            </LinearLayout>

            <Button
                android:id="@+id/ui_preview_toggle"
                style="@style/Widget.EVCam.TopBarButton"
                android:text="开启预览" />
        </LinearLayout>

        <View
            android:id="@+id/ui_topbar_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ui_border" />

        <FrameLayout
            android:id="@+id/ui_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/page_background" />
    </LinearLayout>
</LinearLayout>
