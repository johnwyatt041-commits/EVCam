<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playback_hub_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_background">

    <LinearLayout
        android:id="@+id/playback_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/ui_page_padding"
        android:paddingEnd="@dimen/ui_page_padding"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@color/menu_background">

        <Button
            android:id="@+id/btn_tab_video"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ui_playback_tab_height"
            android:minHeight="@dimen/ui_playback_tab_height"
            android:minWidth="104dp"
            android:layout_marginEnd="10dp"
            android:text="视频回看"
            android:textSize="@dimen/ui_playback_tab_text_size"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:elevation="0dp" />

        <Button
            android:id="@+id/btn_tab_photo"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ui_playback_tab_height"
            android:minHeight="@dimen/ui_playback_tab_height"
            android:minWidth="104dp"
            android:text="照片回看"
            android:textSize="@dimen/ui_playback_tab_text_size"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:elevation="0dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_cleanup_fragments"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ui_playback_tab_height"
            android:minHeight="@dimen/ui_playback_tab_height"
            android:minWidth="96dp"
            android:layout_marginEnd="10dp"
            android:text="清理碎片"
            android:textSize="@dimen/ui_button_text_size"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:elevation="0dp" />

        <Button
            android:id="@+id/btn_lan_share"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ui_playback_tab_height"
            android:minHeight="@dimen/ui_playback_tab_height"
            android:minWidth="140dp"
            android:text="Wi-Fi 分享到手机"
            android:textSize="@dimen/ui_button_text_size"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:elevation="0dp" />
    </LinearLayout>

    <View
        android:id="@+id/playback_tab_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ui_border" />

    <FrameLayout
        android:id="@+id/playback_tab_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/page_background" />
</LinearLayout>
