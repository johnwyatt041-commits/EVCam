<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_background">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="18dp"
        android:paddingBottom="10dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="@color/page_background">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="←"
            android:textSize="16sp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text"
            android:elevation="0dp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:text="6. 广播中心"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- 顶部总览与显式调用说明卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/ui_card"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="内置广播中心（外部快捷控制）"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_broadcast_overview_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Android 8+ 静态接收器必须填写显式目标包名，零后台常驻；通过广播从纯后台拉起主界面需已授予悬浮窗权限。"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_broadcast_package_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:fontFamily="monospace"
                    android:text="目标包名：com.kooo.evcam（点击复制）"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_copy_package_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="复制包名"
                            android:backgroundTint="@color/button_accent"
                            android:textColor="@color/ui_on_accent" />

                        <Button
                            android:id="@+id/btn_copy_all_broadcasts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="复制全部广播清单"
                            android:backgroundTint="@color/button_background"
                            android:textColor="@color/button_text" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 分类筛选与关键词检索 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/ui_card"
                android:layout_marginBottom="14dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_broadcast_filter_all"
                            style="@style/Widget.EVCam.OptionPill"
                            android:layout_marginEnd="8dp"
                            android:text="全部" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_broadcast_filter_foreground"
                            style="@style/Widget.EVCam.OptionPill"
                            android:layout_marginEnd="8dp"
                            android:text="前后台" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_broadcast_filter_recording"
                            style="@style/Widget.EVCam.OptionPill"
                            android:layout_marginEnd="8dp"
                            android:text="录像与抓拍" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_broadcast_filter_preview"
                            style="@style/Widget.EVCam.OptionPill"
                            android:layout_marginEnd="8dp"
                            android:text="主视图切换" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_broadcast_filter_system"
                            style="@style/Widget.EVCam.OptionPill"
                            android:text="保活唤醒" />
                    </LinearLayout>
                </HorizontalScrollView>

                <EditText
                    android:id="@+id/et_broadcast_search"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/edit_text_background"
                    android:hint="搜索广播名称、Action 或说明"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 广播条目容器 -->
            <LinearLayout
                android:id="@+id/layout_broadcast_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_broadcast_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="暂无匹配的内置广播"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
