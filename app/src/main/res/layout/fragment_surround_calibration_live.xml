<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_background">

    <!-- 顶部栏 -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical"
        android:background="@color/page_background">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← 返回"
            android:textSize="15sp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text"
            android:elevation="0dp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="4.3 实时标定与视野调校"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calib_view_bird_only"
            style="@style/Widget.EVCam.OptionPill.Compact"
            android:layout_marginEnd="6dp"
            android:text="鸟瞰大图" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calib_view_full_mode_a"
            style="@style/Widget.EVCam.OptionPill.Compact"
            android:layout_marginEnd="10dp"
            android:text="完整模式 A" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_calib_done"
            style="@style/Widget.EVCam.OptionPill.Compact"
            android:text="完成调校" />
    </LinearLayout>

    <!-- 主体：左实时 360 预览 + 右 4.3 参数调节面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="18dp">

        <!-- 左侧：按需创建的实时 360 预览区 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:layout_marginEnd="14dp"
            android:padding="2dp"
            android:background="@color/ui_border">

            <com.kooo.evcam.surround.SurroundCalibrationPreviewView
                android:id="@+id/surround_calibration_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- 右侧：标定参数调节区 -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.85"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <!-- 标定方案 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/ui_card"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="标定方案"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_live_calibration_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="10dp"
                        android:text="当前方案：银河 E5 内置校准"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_calib_builtin"
                            style="@style/Widget.EVCam.OptionPill"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="银河 E5 内置校准" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_calib_import_local"
                            style="@style/Widget.EVCam.OptionPill"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="导入本地校准" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 四路镜头外参微调 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/ui_card"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="四路镜头外参微调（按方案独立保存）"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_live_extrinsic_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="10dp"
                        android:text="不同标定方案独立保存，切换内置/导入不丢失；调整俯仰角可压平前视远景、对齐四边白线。"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- 镜头选择 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ext_cam_front"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="前摄" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ext_cam_back"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="后摄" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ext_cam_left"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="左摄" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ext_cam_right"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="右摄" />
                    </LinearLayout>

                    <!-- 俯仰角 ΔPitch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/tv_live_ext_pitch_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="俯仰角 ΔPitch：0.0°（正=压低远景 / 负=抬高）"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ext_pitch_minus"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:layout_marginEnd="6dp"
                            android:text="-0.5°" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ext_pitch_plus"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:text="+0.5°" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekbar_live_ext_pitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="80"
                        android:layout_marginBottom="10dp" />

                    <!-- 安装高度 ΔZ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/tv_live_ext_z_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="安装高度 ΔZ：0 cm（负=更低 / 正=更高）"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ext_z_minus"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:layout_marginEnd="6dp"
                            android:text="-2" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ext_z_plus"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:text="+2" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekbar_live_ext_z"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="80"
                        android:layout_marginBottom="10dp" />

                    <!-- 前后偏移 ΔY -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/tv_live_ext_y_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="前后偏移 ΔY：0 cm（正=靠前 / 负=靠后）"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ext_y_minus"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:layout_marginEnd="6dp"
                            android:text="-2" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ext_y_plus"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:text="+2" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekbar_live_ext_y"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="120"
                        android:layout_marginBottom="10dp" />

                    <!-- 高级参数折叠开关 -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_live_ext_toggle_advanced"
                        style="@style/Widget.EVCam.OptionPill.Compact"
                        android:layout_width="match_parent"
                        android:text="展开高级：偏航 / 滚转 / 左右偏移 ▾" />

                    <LinearLayout
                        android:id="@+id/layout_live_ext_advanced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:visibility="gone">

                        <!-- 偏航角 ΔYaw -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:id="@+id/tv_live_ext_yaw_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="偏航角 ΔYaw：0.0°（负=向左 / 正=向右）"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_live_ext_yaw_minus"
                                style="@style/Widget.EVCam.OptionPill.Compact"
                                android:layout_marginEnd="6dp"
                                android:text="-0.5°" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_live_ext_yaw_plus"
                                style="@style/Widget.EVCam.OptionPill.Compact"
                                android:text="+0.5°" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/seekbar_live_ext_yaw"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="80"
                            android:layout_marginBottom="10dp" />

                        <!-- 滚转角 ΔRoll -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:id="@+id/tv_live_ext_roll_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="滚转角 ΔRoll：0.0°（负=逆时针 / 正=顺时针）"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_live_ext_roll_minus"
                                style="@style/Widget.EVCam.OptionPill.Compact"
                                android:layout_marginEnd="6dp"
                                android:text="-0.5°" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_live_ext_roll_plus"
                                style="@style/Widget.EVCam.OptionPill.Compact"
                                android:text="+0.5°" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/seekbar_live_ext_roll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="60"
                            android:layout_marginBottom="10dp" />

                        <!-- 左右偏移 ΔX -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:id="@+id/tv_live_ext_x_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="左右偏移 ΔX：0 cm（负=靠左 / 正=靠右）"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_live_ext_x_minus"
                                style="@style/Widget.EVCam.OptionPill.Compact"
                                android:layout_marginEnd="6dp"
                                android:text="-2" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btn_live_ext_x_plus"
                                style="@style/Widget.EVCam.OptionPill.Compact"
                                android:text="+2" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/seekbar_live_ext_x"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="80" />
                    </LinearLayout>

                    <!-- 底部操作按钮行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ext_reset_camera"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="重置当前镜头" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ext_reset_all"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="清空本方案微调" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_calib_export_json"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="导出校准 JSON" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 地面拼接视野 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/ui_card"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="地面拼接视野（拖动即刻生效）"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <!-- 地面宽度 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/tv_live_ground_width_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="地面宽度：206 cm（160–260）"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ground_width_minus"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:layout_marginEnd="6dp"
                            android:text="-5" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ground_width_plus"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:text="+5" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekbar_live_ground_width"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:layout_marginBottom="10dp" />

                    <!-- 地面长度 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/tv_live_ground_length_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="地面长度：530 cm（420–600）"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ground_length_minus"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:layout_marginEnd="6dp"
                            android:text="-10" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ground_length_plus"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:text="+10" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekbar_live_ground_length"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="180"
                        android:layout_marginBottom="10dp" />

                    <!-- 车头视野延伸 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/tv_live_ground_ext_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="车头视野延伸：0 cm（0–100）"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ground_ext_minus"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:layout_marginEnd="6dp"
                            android:text="-10" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_ground_ext_plus"
                            style="@style/Widget.EVCam.OptionPill.Compact"
                            android:text="+10" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekbar_live_ground_ext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:layout_marginBottom="10dp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_live_ground_reset_default"
                        style="@style/Widget.EVCam.OptionPill"
                        android:text="恢复 E5 默认拼接视野" />
                </LinearLayout>

                <!-- 引导线与车模 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/ui_card"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="动态转向与倒车辅助引导线"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_live_guidance_enabled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/ui_border"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tv_live_car_model_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="当前车模：银河 E5 内置车模"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_car_model_builtin"
                            style="@style/Widget.EVCam.OptionPill"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="E5 内置车模" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_live_car_model_import_png"
