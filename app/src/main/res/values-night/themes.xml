<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style
        name="Base.Theme.Cam"
        parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/button_accent</item>
        <item name="colorPrimaryVariant">@color/button_accent</item>
        <item name="colorOnPrimary">@color/ui_on_accent</item>
        <item name="colorSecondary">@color/button_accent</item>
        <item name="colorSecondaryVariant">@color/button_accent</item>
        <item name="colorOnSecondary">@color/ui_on_accent</item>
        <item name="android:colorBackground">@color/page_background</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/page_background</item>
        <item name="android:navigationBarColor">@color/page_background</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:windowSplashScreenBackground">@color/page_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialButtonStyle">@style/Widget.EVCam.Button</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorSecondaryContainer">@color/button_background</item>
        <item name="colorOnSecondaryContainer">@color/button_text</item>
        <item name="colorPrimaryContainer">@color/ui_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/button_accent</item>
        <item name="colorSurfaceVariant">@color/input_background</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/ui_border</item>
        <item name="colorControlActivated">@color/button_accent</item>
    </style>
    <style
        name="NavigationMenuTextAppearance"
        parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/nav_text_primary</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="NavigationViewStyle">
        <item name="itemBackground">@drawable/nav_item_background</item>
        <item name="itemIconTint">@color/nav_icon_tint</item>
        <item name="itemTextColor">@color/nav_text_primary</item>
        <item name="itemShapeFillColor">@android:color/transparent</item>
        <item name="itemIconPadding">16dp</item>
        <item name="itemHorizontalPadding">20dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style
        name="NavigationSubheaderTextAppearance"
        parent="TextAppearance.AppCompat.Body2">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/nav_section_title</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
    </style>
    <style
        name="Theme.Cam.MaterialAlertDialog"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/button_accent</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Cam.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Cam.Body</item>
    </style>
    <style
        name="MaterialAlertDialog.Cam.Title"
        parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">22sp</item>
    </style>
    <style
        name="MaterialAlertDialog.Cam.Body"
        parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">18sp</item>
    </style>
</resources>