<resources>
    <style
        name="Widget.EVCam.Button"
        parent="Widget.Material3.Button.TonalButton">
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item><item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item><item name="android:stateListAnimator">@null</item>
    </style>
    <style
        name="Widget.EVCam.Navigation"
        parent="">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/ui_nav_height</item>
        <item name="android:layout_marginBottom">@dimen/ui_nav_gap</item><item name="android:padding">@dimen/ui_nav_padding</item>
        <item name="android:gravity">center</item><item name="android:textSize">@dimen/ui_nav_text_size</item>
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:drawablePadding">@dimen/ui_nav_icon_gap</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/ui_nav_text</item><item name="android:background">@drawable/ui_nav_item</item>
        <item name="android:clickable">true</item><item name="android:focusable">true</item>
    </style>
</resources>
