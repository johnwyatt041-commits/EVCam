<resources>
    <style
        name="Widget.EVCam.Button"
        parent="Widget.Material3.Button.TonalButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/ui_button_text_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/ui_button_height</item>
        <item name="android:minWidth">@dimen/ui_button_min_width</item>
        <item name="android:paddingStart">@dimen/ui_button_padding_h</item>
        <item name="android:paddingEnd">@dimen/ui_button_padding_h</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style
        name="Widget.EVCam.TopBarButton"
        parent="Widget.EVCam.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/ui_top_bar_button_height</item>
        <item name="android:minHeight">@dimen/ui_top_bar_button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/ui_top_bar_button_padding_h</item>
        <item name="android:paddingEnd">@dimen/ui_top_bar_button_padding_h</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">@dimen/ui_top_bar_button_text_size</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style
        name="Widget.EVCam.Switch"
        parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/ui_switch_thumb</item>
        <item name="trackTint">@color/ui_switch_track</item>
    </style>

    <style
        name="Widget.EVCam.OptionPill"
        parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/ui_pill_height</item>
        <item name="android:minHeight">@dimen/ui_pill_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/ui_pill_padding_h</item>
        <item name="android:paddingEnd">@dimen/ui_pill_padding_h</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/ui_pill_text_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style
        name="Widget.EVCam.OptionPill.Compact"
        parent="Widget.EVCam.OptionPill">
        <item name="android:layout_height">@dimen/ui_pill_compact_height</item>
        <item name="android:minHeight">@dimen/ui_pill_compact_height</item>
        <item name="android:paddingStart">@dimen/ui_top_bar_button_padding_h</item>
        <item name="android:paddingEnd">@dimen/ui_top_bar_button_padding_h</item>
    </style>

    <style
        name="Widget.EVCam.RecorderTab"
        parent="Widget.EVCam.Button">
        <item name="android:layout_height">@dimen/ui_tab_button_height</item>
        <item name="android:minHeight">@dimen/ui_tab_button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/ui_top_bar_button_padding_h</item>
        <item name="android:paddingEnd">@dimen/ui_top_bar_button_padding_h</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">@dimen/ui_tab_button_text_size</item>
        <item name="android:maxLines">1</item>
    </style>

    <style
        name="Widget.EVCam.EditorButton"
        parent="Widget.EVCam.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/ui_editor_button_height</item>
        <item name="android:minHeight">@dimen/ui_editor_button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/ui_top_bar_button_padding_h</item>
        <item name="android:paddingEnd">@dimen/ui_top_bar_button_padding_h</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">@dimen/ui_editor_button_text_size</item>
        <item name="android:maxLines">1</item>
    </style>

    <style
        name="Widget.EVCam.CompactFilterButton"
        parent="Widget.EVCam.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style
        name="Widget.EVCam.Navigation"
        parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/ui_nav_height</item>
        <item name="android:layout_marginBottom">@dimen/ui_nav_gap</item>
        <item name="android:paddingStart">@dimen/ui_nav_padding</item>
        <item name="android:paddingEnd">@dimen/ui_nav_padding</item>
        <item name="android:paddingTop">@dimen/ui_nav_padding_v</item>
        <item name="android:paddingBottom">@dimen/ui_nav_padding_v</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/ui_nav_text_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:drawablePadding">@dimen/ui_nav_icon_gap</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/ui_nav_text</item>
        <item name="android:background">@drawable/ui_nav_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style
        name="Widget.EVCam.Navigation.Footer"
        parent="Widget.EVCam.Navigation">
        <item name="android:minHeight">@dimen/ui_nav_footer_height</item>
        <item name="android:layout_marginBottom">@dimen/ui_nav_gap</item>
    </style>
</resources>
